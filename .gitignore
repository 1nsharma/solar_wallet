# ============================================================
# SolarSync .gitignore
# Security best practices - Never commit sensitive files
# ============================================================

# ==================== ENVIRONMENT & SECRETS ====================
.env
.env.local
.env.production
backend/.env
**/*.env
*.pem
*.key
*.cert

# ==================== NODE / NPM ====================
node_modules/
backend/node_modules/
mobile_app/.dart_tool/
mobile_app/.packages
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ==================== BUILD OUTPUT ====================
dist/
build/
mobile_app/build/
*.apk
*.aab
*.ipa

# ==================== IDE / EDITOR ====================
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# ==================== ARDUINO / ESP32 ====================
hardware/.vscode/
hardware/build/
*.hex
*.elf
*.bin

# ==================== DATABASE ====================
*.sql.bak
*.dump
database/backups/

# ==================== LOGS ====================
logs/
*.log
backend/logs/

# ==================== FLUTTER ====================
mobile_app/.flutter-plugins
mobile_app/.flutter-plugins-dependencies
mobile_app/.metadata
mobile_app/pubspec.lock

# ==================== TESTING ====================
coverage/
.nyc_output/
*.test.js.map

# ==================== TEMP FILES ====================
tmp/
temp/
*.tmp
*.temp

# ==================== OS FILES ====================
.DS_Store
Thumbs.db
desktop.ini

# ==================== CREDENTIALS ====================
**/credentials.json
**/service-account*.json
**/firebase*.json
.next/

# Temporary / Extraneous projects
admin-dashboard/
gitforge/
